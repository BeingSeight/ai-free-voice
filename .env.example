# Copy to .env and fill in — ONLY you (admin) edit these. Team members never see them.
OPENROUTER_API_KEY=        # from openrouter.ai/keys
OPENROUTER_MODEL=heygen/heygen-voice-1-turbo:free  # free variant; paid = heygen/heygen-voice-1-turbo ($4/M chars)
OPENROUTER_VOICE=          # ONE voice id chosen by you (see README) — leave empty for default voice
HEYGEN_API_KEY=            # optional: BYO HeyGen key ONLY if you cloned a voice on HeyGen and want to use it
PORT=3000
SPEED=1
MAX_CHARS=5000
# Rate limit safety (OpenRouter free tier: ~20/min, ~50/day if <$10 purchased, 1000/day if >=$10 — shared account-wide)
RATE_MIN_INTERVAL_MS=3000
RATE_MAX_PER_MINUTE=10
RATE_MAX_PER_DAY=50
